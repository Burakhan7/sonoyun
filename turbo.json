{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": [
        "NEXT_PUBLIC_REALTIME_URL",
        "REALTIME_INTERNAL_URL",
        "INTERNAL_API_SECRET",
        "ADMIN_USER",
        "ADMIN_PASSWORD",
        "ADMIN_IP_ALLOWLIST",
        "SENTRY_DSN",
        "NEXT_PUBLIC_SENTRY_DSN",
        "NEXT_PUBLIC_PLAUSIBLE_DOMAIN"
      ],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "passThroughEnv": ["TEST_REDIS_URL", "TEST_DATABASE_URL"]
    }
  }
}
