# Copy to apps/realtime/.env
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3100
DATABASE_URL=postgresql://app:app_dev_password@localhost:5432/oyun_sohbet
REDIS_URL=redis://localhost:6379
# At least 32 characters: openssl rand -base64 48
JWT_SECRET=
# Development only: lets two browsers on this machine match. Rejected in production.
MATCH_ALLOW_SAME_IP=true
# Set to true behind a reverse proxy (Railway) so the real client IP is used.
TRUST_PROXY=false
