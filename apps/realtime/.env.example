# Copy to apps/realtime/.env
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3100
DATABASE_URL=postgresql://app:app_dev_password@127.0.0.1:5432/oyun_sohbet
REDIS_URL=redis://127.0.0.1:6379
# At least 32 characters: openssl rand -base64 48
JWT_SECRET=
# Development only: lets two browsers on this machine match, even a private window of the same
# browser (same IP and device summary). Rejected in production.
MATCH_ALLOW_SAME_IP=true
# Keep users away from their last 20 opponents. Off for now: partners are picked at random.
MATCH_AVOID_RECENT=false
# Set to true behind a reverse proxy (Railway) so the real client IP is used.
TRUST_PROXY=false
# Shared with the web app so the realtime service can trust the forwarded client IP.
# Required in production, at least 32 characters.
INTERNAL_API_SECRET=
# New guest accounts allowed per IP per hour.
GUEST_LIMIT_PER_HOUR=30
# Optional: error tracking. Reports never include chat content or user identity.
SENTRY_DSN=
