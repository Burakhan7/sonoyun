# Copy to apps/web/.env.local
NEXT_PUBLIC_REALTIME_URL=http://localhost:4000
# Server-side URL the Next.js API routes use to reach the realtime service
REALTIME_INTERNAL_URL=http://localhost:4000
# Must match INTERNAL_API_SECRET in the realtime service. Never prefix with NEXT_PUBLIC_.
INTERNAL_API_SECRET=
# Admin panel. It stays hidden (404) unless all three are set.
ADMIN_USER=
ADMIN_PASSWORD=
# Comma-separated exact IP addresses allowed to open /admin
ADMIN_IP_ALLOWLIST=
# Optional: error tracking
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Optional: analytics domain. The consent banner appears only when this is set.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
